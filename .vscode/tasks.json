{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve Local (filtered)",
            "type": "shell",
            "command": "./bin/serve-local",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "isBackground": true,
        },
        {
            "label": "Serve",
            "type": "shell",
            "command": "bundle exec jekyll serve --livereload",
            "group": {
                "kind": "test"
            },
            "isBackground": true,
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "bundle exec jekyll build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "bundle exec jekyll clean",
        }
    ]
}